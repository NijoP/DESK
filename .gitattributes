# Normalise line endings: LF in the repository, native on checkout is NOT used (eol=lf everywhere)
# so Windows, Linux and macOS contributors produce identical diffs. Python and JSON do not care.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary artefacts
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
*.jar binary
*.zip binary
*.epro2 binary
*.epro binary
*.db binary
*.ttf binary
*.woff binary
*.woff2 binary

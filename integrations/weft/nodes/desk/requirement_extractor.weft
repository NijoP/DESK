# DeskRequirementExtractor 1.0.0: Ask a model to restate the stored requirements as structured notes. Advisory only: the deterministic classifier decides.
Group(service: String, projectId: String, runId: String, requirementsHash: String) -> (passed: Boolean, blocking: List[String], evidence: List[String], notesRef: String, provider: String, model: String) {
  # Generated from desk/weft/contracts.py. Engine: desk.orchestrator (provider adapters)
  type DeskRequirementExtractorEnvelope = {
    node: String,
    version: String,
    ok: Boolean,
    passed: Boolean,
    outputs: { notesRef: String, provider: String, model: String, .. },
    blockingIssues: List[String],
    evidence: List[String],
    ..
  }
  url = Format(service: String) {
    service: self.service
    template: "{{service}}/v1/nodes/DeskRequirementExtractor"
  }
  request = JsonObject {
    projectId: self.projectId
    runId: self.runId
    requirementsHash: self.requirementsHash
  }
  call = HttpRequest {
    url: url.text
    method: "POST"
    body: request.object
  }
  checked = Cast -> (value: DeskRequirementExtractorEnvelope) { value: call.body }
  self.passed = checked.value.passed
  self.blocking = checked.value.blockingIssues
  self.evidence = checked.value.evidence
  self.notesRef = checked.value.outputs.notesRef
  self.provider = checked.value.outputs.provider
  self.model = checked.value.outputs.model
}

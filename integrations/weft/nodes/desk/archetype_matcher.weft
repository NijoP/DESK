# DeskArchetypeMatcher 0.1.0: Match a classified design against archetype reference designs. [UNAVAILABLE, fails closed: covered today by DeskDomainClassifier candidates; no separate matcher engine]
Group(service: String, projectId: String, runId: String) -> (passed: Boolean, blocking: List[String], evidence: List[String]) {
  # Generated from desk/weft/contracts.py. Engine: desk.domain_intelligence
  type DeskArchetypeMatcherEnvelope = {
    node: String,
    version: String,
    ok: Boolean,
    passed: Boolean,
    outputs: JsonDict,
    blockingIssues: List[String],
    evidence: List[String],
    ..
  }
  url = Format(service: String) {
    service: self.service
    template: "{{service}}/v1/nodes/DeskArchetypeMatcher"
  }
  request = JsonObject {
    projectId: self.projectId
    runId: self.runId
  }
  call = HttpRequest {
    url: url.text
    method: "POST"
    body: request.object
  }
  checked = Cast -> (value: DeskArchetypeMatcherEnvelope) { value: call.body }
  self.passed = checked.value.passed
  self.blocking = checked.value.blockingIssues
  self.evidence = checked.value.evidence
}

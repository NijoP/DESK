# DeskNetlistVerifier 0.1.0: Compare the drawn netlist with the block specs. [UNAVAILABLE, fails closed: reading the drawn netlist needs the live EasyEDA bridge]
Group(service: String, projectId: String, runId: String) -> (passed: Boolean, blocking: List[String], evidence: List[String]) {
  # Generated from desk/weft/contracts.py. Engine: desk.netcheck.compare
  type DeskNetlistVerifierEnvelope = {
    node: String,
    version: String,
    ok: Boolean,
    passed: Boolean,
    outputs: JsonDict,
    blockingIssues: List[String],
    evidence: List[String],
    ..
  }
  url = Format(service: String) {
    service: self.service
    template: "{{service}}/v1/nodes/DeskNetlistVerifier"
  }
  request = JsonObject {
    projectId: self.projectId
    runId: self.runId
  }
  call = HttpRequest {
    url: url.text
    method: "POST"
    body: request.object
  }
  checked = Cast -> (value: DeskNetlistVerifierEnvelope) { value: call.body }
  self.passed = checked.value.passed
  self.blocking = checked.value.blockingIssues
  self.evidence = checked.value.evidence
}

# DeskDatasheetVerifier 0.1.0: Verify electrical parameters against the datasheet. [UNAVAILABLE, fails closed: DESK stores datasheet references only; there is no datasheet parser]
Group(service: String, projectId: String, runId: String) -> (passed: Boolean, blocking: List[String], evidence: List[String]) {
  # Generated from desk/weft/contracts.py. Engine: desk.component_intelligence.api.verify_component
  type DeskDatasheetVerifierEnvelope = {
    node: String,
    version: String,
    ok: Boolean,
    passed: Boolean,
    outputs: JsonDict,
    blockingIssues: List[String],
    evidence: List[String],
    ..
  }
  url = Format(service: String) {
    service: self.service
    template: "{{service}}/v1/nodes/DeskDatasheetVerifier"
  }
  request = JsonObject {
    projectId: self.projectId
    runId: self.runId
  }
  call = HttpRequest {
    url: url.text
    method: "POST"
    body: request.object
  }
  checked = Cast -> (value: DeskDatasheetVerifierEnvelope) { value: call.body }
  self.passed = checked.value.passed
  self.blocking = checked.value.blockingIssues
  self.evidence = checked.value.evidence
}

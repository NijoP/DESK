# Rendered into .desk_weft/validator/ by `python desk.py weft build-validator --checkout <weft checkout>`.
# The checkout's own Cargo.lock is copied beside it, so dependency versions are upstream's.
[package]
name = "desk-weft-validate"
version = "0.1.0"
edition = "2021"

[dependencies]
weft-core = { path = "@CHECKOUT@/crates/weft-core", default-features = false }
weft-compiler = { path = "@CHECKOUT@/crates/weft-compiler", default-features = false }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
toml = "1"
anyhow = "1"
thiserror = "2"
tracing = "0.1"
uuid = "1"

[workspace]

   "severity": "BLOCKING",
   "applicability": {
    "all": []
   },
   "required_inputs": [
    "output_current_a",
    "ripple_ratio",
    "inductor_isat_a"
   ],
   "evaluation_method": "desk.rules.inductor_margin",
   "parameters": {

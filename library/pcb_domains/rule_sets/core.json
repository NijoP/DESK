{
 "schema_version": "1.0.0",
 "rule_set_id": "core",
 "rules": [
  {
   "rule_id": "ELEC-WIDTH-001",
   "name": "Trace width from declared current (IPC-2221)",
   "version": "1.0.0",
   "domain": "core",
   "category": "electrical",
   "scope": {
    "archetypes": [
     "*"
    ],
    "overlays": [],
    "component_families": []
   },
   "severity": "BLOCKING",
   "applicability": {
    "all": []
   },
   "required_inputs": [
    "net_currents_a",
    "copper_oz",
    "temperature_rise_c",
    "layer"
   ],
   "evaluation_method": "desk.ipc.trace_width",
   "parameters": {
    "temperature_rise_c_default": 10.0,
    "min_signal_width_mil": 5.0
   },
   "source_references": [
    "IPC-2221B",
    "JLCPCB-CAPABILITIES"
   ],
   "verification_method": "tools/route.py sizes every net from DesignProfile.derive_trace_width_mil; tests/test_ipc_models.py, tests/test_hardware_reference_values.py",
   "status": "OFFLINE_TESTED",
   "enforcement": {
    "subsystem": "routing.width",
    "mode": "ENFORCED"
   },
   "human_review_required": false,
   "rationale": "A power net sized without its current is a guess; DESK refuses (unknown_current_policy=fail)."
  },
  {
   "rule_id": "ELEC-UNKNOWN-002",
   "name": "Unknown electrical inputs fail closed",
   "version": "1.0.0",
   "domain": "core",

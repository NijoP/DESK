  {
   "rule_id": "ROUTE-DIFF-021",
   "name": "Differential pairs at the interface impedance with matched length",
   "version": "1.0.0",
   "domain": "core",
   "category": "routing",
   "scope": {
    "archetypes": [],
    "overlays": [
     "usb_interface",
     "high_speed_digital",
     "can_interface",
     "industrial_interfaces"
    ],
    "component_families": []
   },
   "severity": "ERROR",
   "applicability": {
    "any": [
     {
      "field": "protocols",
      "op": "intersects",
      "value": [
       "usb",
       "pcie",
       "ddr",
       "hdmi",
       "mipi",
       "ethernet",
       "gigabit",
       "can",
       "rs485"
      ]
     }
    ]
   },
   "required_inputs": [
    "diff_pairs",
    "stackup"
   ],
   "evaluation_method": "desk.routing.diff_pair",
   "parameters": {
    "usb_ohm": 90,
    "ethernet_ohm": 100,
    "pcie_gen3_ohm": 85,
    "can_rs485_ohm": 120
   },
   "source_references": [
    "USB-2.0",
    "IEEE-802.3",
    "PCIe-CEM",
    "ISO-11898-2",
    "TIA-485-A"
   ],
   "verification_method": "DiffPairProfile carried into DSN net classes (width/spacing); length matching and impedance are not verified by DESK (router.DiffPairVerification not wired)",
   "status": "IMPLEMENTED",
   "enforcement": {
    "subsystem": "routing",
    "mode": "ADVISORY"
   },
   "human_review_required": false,
   "rationale": "Geometry is applied; the result is not verified, so advisory until DiffPairVerification is wired into quality gates."
  },

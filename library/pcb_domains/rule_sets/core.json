  {
   "rule_id": "ELEC-CLEAR-003",
   "name": "Electrical clearance from working voltage (IPC-2221B Table 6-1)",
   "version": "1.0.0",
   "domain": "core",
   "category": "electrical",
   "scope": {
    "archetypes": [
     "*"
    ],
    "overlays": [],
    "component_families": []
   },
   "severity": "BLOCKING",
   "applicability": {
    "all": []
   },
   "required_inputs": [
    "voltage_rails",
    "clearance_condition",
    "manufacturing.min_clearance_mil"
   ],
   "evaluation_method": "desk.profile.clearance",
   "parameters": {
    "condition_default": "B2"
   },
   "source_references": [
    "IPC-2221B",
    "JLCPCB-CAPABILITIES"
   ],
   "verification_method": "DesignProfile.derive_clearance_mil -> desk.ipc.required_spacing_mil; written to DSN net classes; tests/test_hardware_reference_values.py",
   "status": "OFFLINE_TESTED",
   "enforcement": {
    "subsystem": "routing.clearance",
    "mode": "ENFORCED"
   },
   "human_review_required": false,
   "rationale": "Table values are transcribed, not yet verified against the standard text (ipc.verified_against_standard=False)."
  },
  {
   "rule_id": "ELEC-CREEP-004",
   "name": "Creepage from working voltage, pollution degree and material group (IEC 60664-1 Table F.4)",
   "version": "1.0.0",
   "domain": "core",
   "category": "electrical",
   "scope": {
    "archetypes": [],
    "overlays": [
     "mains_safety_isolation",
     "galvanic_isolation"
    ],
    "component_families": []
   },
   "severity": "BLOCKING",
   "applicability": {
    "any": [
     {
      "field": "input_voltage_v",
      "op": ">=",
      "value": 60
     },
     {
      "field": "mains",
      "op": "==",
      "value": true
     },
     {
      "field": "isolation",
      "op": "==",
      "value": true
     }
    ]
   },
   "required_inputs": [
    "voltage_rails",
    "pollution_degree",
    "material_group",
    "isolation_voltage_v"
   ],
   "evaluation_method": "desk.profile.creepage",
   "parameters": {
    "pollution_degree_default": 2,
    "material_group_default": "III"
   },
   "source_references": [
    "IEC-60664-1"
   ],
   "verification_method": "desk.ipc.creepage_mm; max(clearance, creepage, fabricator minimum) becomes the net-pair spacing; tests/test_ipc_models.py",
   "status": "OFFLINE_TESTED",
   "enforcement": {
    "subsystem": "routing.clearance",
    "mode": "ENFORCED"
   },
   "human_review_required": true,
   "rationale": "Human review required because the table transcription is unverified against the IEC text."
  },
  {
   "rule_id": "ELEC-VIA-005",
   "name": "Via ampacity and parallel via count",
   "version": "1.0.0",
   "domain": "core",
   "category": "electrical",
   "scope": {
    "archetypes": [],
    "overlays": [
     "high_current",
     "switching_power",
     "motor_drive"
    ],
    "component_families": []
   },
   "severity": "ERROR",
   "applicability": {
    "any": [
     {
      "field": "current_a",
      "op": ">=",
      "value": 1.0
     }
    ]
   },
   "required_inputs": [
    "net_currents_a",
    "via_drill_mil",
    "plating_um"
   ],
   "evaluation_method": "desk.ipc.via_current",
   "parameters": {
    "plating_um_default": 25.0,
    "temperature_rise_c_default": 10.0
   },
   "source_references": [
    "IPC-2221B"
   ],
   "verification_method": "desk.ipc.via_current_a / vias_required; reported by tools/route.py; not yet enforced in DSN (router places vias freely)",
   "status": "IMPLEMENTED",
   "enforcement": {
    "subsystem": "routing.vias",
    "mode": "ADVISORY"
   },
   "human_review_required": false,
   "rationale": "The engine computes the count; the autorouter does not yet honour it, so the rule is advisory."
  },
  {

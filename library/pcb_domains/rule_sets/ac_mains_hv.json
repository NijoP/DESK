  {
   "rule_id": "MAINS-DECL-160",
   "name": "Every mains/HV net declared in voltage_rails before any spacing is derived",
   "version": "1.0.0",
   "domain": "ac_mains_hv",
   "category": "electrical",
   "scope": {
    "archetypes": [],
    "overlays": [
     "mains_safety_isolation"
    ],
    "component_families": []
   },
   "severity": "BLOCKING",
   "applicability": {
    "all": []
   },
   "required_inputs": [
    "voltage_rails"
   ],
   "evaluation_method": "desk.profile.validate_electrical_inputs",
   "parameters": {
    "hv_pattern": "HV|MAINS|AC_|_L$|_N$|LINE|NEUTRAL|BUS|400V|VDC_BUS"
   },
   "source_references": [
    "IEC-60664-1"
   ],
   "verification_method": "DesignProfile.get_net_voltage_status flags HV-looking nets without a declared voltage; derive_clearance_mil raises",
   "status": "OFFLINE_TESTED",
   "enforcement": {
    "subsystem": "quality.gate",
    "mode": "ENFORCED"
   },
   "human_review_required": true,
   "rationale": ""
  },
  {
   "rule_id": "MAINS-FUSE-161",
   "name": "Fuse first after the mains connector; MOV after the fuse",
   "version": "1.0.0",
   "domain": "ac_mains_hv",
   "category": "electrical",
   "scope": {
    "archetypes": [],
    "overlays": [
     "mains_safety_isolation"
    ],
    "component_families": []
   },
   "severity": "ERROR",
   "applicability": {
    "all": [
     {
      "field": "mains",
      "op": "==",
      "value": true
     }
    ]
   },
   "required_inputs": [
    "component_families_present"
   ],
   "evaluation_method": "desk.rules.family_present",
   "parameters": {
    "any_of": [
     "fuse"
    ]
   },
   "source_references": [
    "IEC-62368-1",
    "IEC-60335-1"
   ],
   "verification_method": "Deterministic family presence; order is a schematic review item",
   "status": "OFFLINE_TESTED",
   "enforcement": {
    "subsystem": "quality.gate",
    "mode": "ENFORCED"
   },
   "human_review_required": true,
   "rationale": ""
  },
